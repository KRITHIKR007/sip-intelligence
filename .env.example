# =============================================================================
# SIP Intelligence Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_NAME=SIP Intelligence
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-64-char-string
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=2
APP_LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sip_user
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=sip_intelligence
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j-password

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/1

# --- MinIO (S3-compatible object storage) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET_DOCUMENTS=sip-documents
MINIO_BUCKET_PROCESSED=sip-processed
MINIO_BUCKET_SYMBOLS=sip-symbols
MINIO_BUCKET_EXPORTS=sip-exports
MINIO_USE_SSL=false

# --- OpenSearch (BM25) ---
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=change-me-opensearch-password
OPENSEARCH_INDEX_PREFIX=sip

# --- ML Models ---
# Text embedding
TEXT_EMBEDDING_MODEL=BAAI/bge-m3
TEXT_EMBEDDING_DIM=1024
TEXT_EMBEDDING_DEVICE=cpu
TEXT_EMBEDDING_BATCH_SIZE=8

# Visual embedding
VISUAL_EMBEDDING_MODEL=google/siglip2-base-patch16-224
VISUAL_EMBEDDING_DEVICE=cpu
VISUAL_EMBEDDING_BATCH_SIZE=4

# Reranker
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

# Symbol detection
SYMBOL_DETECTOR_MODEL=yolo11n
SYMBOL_DETECTOR_CONFIDENCE=0.25
SYMBOL_CLASSIFIER_MODEL=convnext_tiny

# OCR
OCR_ENGINE=paddleocr
OCR_LANG=en

# --- Chunking ---
CHUNK_SIZE=512
CHUNK_OVERLAP=80

# --- Retrieval ---
RETRIEVAL_TOP_K=50
RERANK_TOP_K=10
DENSE_WEIGHT=0.30
BM25_WEIGHT=0.20
VISUAL_WEIGHT=0.20
STRUCTURAL_WEIGHT=0.15
GRAPH_WEIGHT=0.15

# --- External AI Gateway (disabled by default) ---
CLOUD_AI_ENABLED=false
CLOUD_AI_PROVIDER=
CLOUD_AI_API_KEY=
CLOUD_AI_MODEL=
CLOUD_AI_APPROVED_CONTENT_TYPES=

# --- Authentication ---
JWT_SECRET_KEY=change-me-jwt-secret-key-64-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=500
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,dwg,dxf,xlsx,xls,csv,docx,doc

# --- Processing ---
MAX_CONCURRENT_JOBS=4
JOB_TIMEOUT_SECONDS=3600

